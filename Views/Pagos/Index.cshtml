@model IEnumerable<SIPAME.Models.Pago>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create Nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MontoPago)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FormaPago)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaPago)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaInicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaFin)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.ClienteId)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Cliente)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.ContratacionId)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Contratacion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.MontoPago)</td>
                <td>@Html.DisplayFor(modelItem => item.FormaPago)</td>
                <td>@Html.DisplayFor(modelItem => item.FechaPago)</td>
                <td>@Html.DisplayFor(modelItem => item.FechaInicio)</td>
                <td>@Html.DisplayFor(modelItem => item.FechaFin)</td>

                <!-- Muestra el Nombre Completo del Cliente -->
                <td>
                    @(item.Cliente != null ? $"{item.Cliente.Nombre} {item.Cliente.Apellido}" : "Sin Cliente")
                </td>

                <!-- Muestra información útil de la contratación, por ejemplo su ID o tipo -->
                <td>
                    @(item.Contratacion != null ? $"#{item.Contratacion.ContratacionId} - {item.Contratacion.TpoContratacion}" : "Sin Contratación")
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.PagoId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.PagoId">Details</a> 
                    @*<a asp-action="Delete" asp-route-id="@item.PagoId">Delete</a>*@
                </td>
            </tr>
        }

