@model SIPAME.Models.Pago

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Pago</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="MontoPago" class="control-label"></label>
                <input asp-for="MontoPago" class="form-control" />
                <span asp-validation-for="MontoPago" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FormaPago" class="control-label fw-bold">Forma de pago</label>
                <select asp-for="FormaPago" class="form-control" id="FormaPago">
                    <option value="">-- Seleccione Tipo --</option>
                    <!-- CORREGIDO: Se cambiaron los valores para coincidir con el modelo Pago -->
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
                <span asp-validation-for="FormaPago" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaPago" class="control-label"></label>
                <input asp-for="FechaPago" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>

            <!-- MODIFICADO: Se añade 'readonly' para que se calculen automáticamente por sistema -->
            <div class="form-group mb-3">
                <label asp-for="FechaInicio" class="control-label"></label>
                <input asp-for="FechaInicio" class="form-control" type="date" id="FechaInicio" readonly />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaFin" class="control-label"></label>
                <input asp-for="FechaFin" class="form-control" type="date" id="FechaFin" readonly />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="control-label">Cliente</label>
                <select asp-for="ClienteId" id="SelectCliente" class="form-control" asp-items="ViewBag.ClienteId">
                    <option value="">-- Seleccione un cliente --</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ContratacionId" class="control-label">Contratación</label>
                <select asp-for="ContratacionId" id="SelectContratacion" class="form-control" asp-items="ViewBag.ContratacionId">
                    <option value="">-- Seleccione una contratación --</option>
                </select>
                <span asp-validation-for="ContratacionId" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- Cargamos jQuery desde una CDN estable de forma correcta -->
    <script src="https://jquery.com"></script>
    <script>
        $(document).ready(function () {

            // 1. Al cambiar el Cliente se cargan las contrataciones correspondientes
            $("#SelectCliente").change(function () {
                var idCliente = $(this).val();
                var ddlContratacion = $("#SelectContratacion");

                ddlContratacion.empty();
                ddlContratacion.append('<option value="">-- Seleccione una contratación --</option>');

                // Limpiamos las fechas si se cambia de cliente
                $("#FechaInicio").val("");
                $("#FechaFin").val("");

                if (idCliente) {
                    $.getJSON('@Url.Action("GetContratacionesPorCliente", "Pagos")', { clienteId: idCliente }, function (data) {
                        $.each(data, function (index, item) {
                            ddlContratacion.append($('<option/>', {
                                value: item.value,
                                text: item.text
                            }));
                        });
                    });
                }
            });

            // 2. NUEVO EVENTO: Al cambiar la Contratación se calculan las fechas del periodo
            $("#SelectContratacion").change(function () {
                var idContratacion = $(this).val();

                // Limpiamos los inputs temporalmente
                $("#FechaInicio").val("");
                $("#FechaFin").val("");

                if (idContratacion) {
                    // Llamamos al nuevo método del controlador que creamos en el paso anterior
                    $.getJSON('@Url.Action("ObtenerFechasPeriodo", "Pagos")', { contratacionId: idContratacion }, function (data) {
                        if (data.success) {
                            // Asignamos los valores devueltos en formato yyyy-MM-dd
                            $("#FechaInicio").val(data.fechaInicio);
                            $("#FechaFin").val(data.fechaFin);
                        } else {
                            alert(data.message);
                        }
                    }).fail(function() {
                        console.error("Error al conectar con el servidor para obtener el periodo.");
                    });
                }
            });
        });
    </script>
}





