@model SIPAME.Models.Pago

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cloudflare.com" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-secondary fw-bold"><i class="fas fa-list-check me-2"></i>Pagos registrados</h2>

        @* Botón con estilo moderno *@
        <button type="button" onclick="limpiaraddpago()" class="btn btn-success btn-lg shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalpago">
            <i class="fas fa-plus-circle me-2"></i>Agregar pago
        </button>
    </div>

    @* Listado de estatus envuelto en una Card Profesional *@
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom-0">
            <h5 class="card-title mb-0 text-muted uppercase small fw-bold">Gestión de Catálogo</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tbpagos" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th>Clave</th>
                            <th>Monto de pago</th>
                            <th>Forma de pago</th>
                            <th>Fecha de pago</th>
                            <th>Fecha de inicio</th>
                            <th>Fecha de fin</th>
                            <th>Cliente</th>
                            <th>Contratacion</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Llenado por DataTable *@
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Optimizado -->
<div class="modal fade" id="modalpago" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="staticBackdropLabel">
                    <i class="fas fa-edit me-2"></i>Datos de contratacion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="this.blur()"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-action="Create" id="formContratacion">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="PagoId" id="PagoId" />

                    <div class="form-floating mb-3">
                        <input asp-for="MontoPago" id="MontoPago" class="form-control" placeholder="Ej. 500" />
                        <label asp-for="MontoPago">Teléfono del Cliente</label>
                        <span asp-validation-for="MontoPago" class="text-danger small"></span>
                    </div>


                    <div class="form-group mb-3">
                        <label asp-for="FormaPago" class="control-label fw-bold">Forma de pago</label>
                        <select asp-for="FormaPago" class="form-control" id="FormaPago">
                            <option value="">-- Seleccione Forma de pago --</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia</option>
                        </select>
                        <span asp-validation-for="FormaPago" class="text-danger small"></span>
                    </div>

                    @* Inputs de fecha unificados para evitar duplicaciones *@
                    <div class="form-floating mb-3">
                        <input type="date" asp-for="FechaPago" id="FechaPago" class="form-control" />
                        <label asp-for="FechaPago">Fecha de pago</label>
                        <span asp-validation-for="FechaPago" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="date" asp-for="FechaInicio" id="FechaInicio" class="form-control" />
                        <label asp-for="FechaInicio">Fecha de inicio</label>
                        <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="date" asp-for="FechaFin" id="FechaFin" class="form-control" />
                        <label asp-for="FechaFin">Fecha de fin</label>
                        <span asp-validation-for="FechaFin" class="text-danger small"></span>
                    </div>


