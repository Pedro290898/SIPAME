@model SIPAME.Models.Contratacion

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Contratacion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FechaContratacion" class="control-label"></label>
                <input asp-for="FechaContratacion" class="form-control" />
                <span asp-validation-for="FechaContratacion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TpoContratacion" class="control-label"></label>
                <input asp-for="TpoContratacion" class="form-control" />
